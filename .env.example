# =============================================================================
# Cryptomation Bootstrap — Environment Variables
#
# Copy to .env before first run:
#   cp .env.example .env
# =============================================================================

# Port nginx listens on (change if 80 is taken on your machine)
NGINX_HTTP_PORT=80

# Domain nginx responds to (server_name). Add to /etc/hosts → 127.0.0.1
NGINX_SERVER_NAME=cryptomation.local
