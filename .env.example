# =============================================================================
# Cryptomation Bootstrap — Environment Variables
#
# Copy to .env before first run:
#   cp .env.example .env
# =============================================================================

# Port nginx listens on (change if 80 is taken on your machine)
NGINX_HTTP_PORT=80

# Domain nginx responds to (server_name). Add to /etc/hosts → 127.0.0.1
NGINX_SERVER_NAME=cryptomation.local

# Host port for Mailpit web UI (change if 8025 is taken)
MAILPIT_UI_PORT=8025

# PostgreSQL (shared by Laravel and future apps)
POSTGRES_DB=cryptomation
POSTGRES_USER=cryptomation
POSTGRES_PASSWORD=cryptomation
POSTGRES_HOST_PORT=5432
