# =============================================================================
# cryptomation-frontend — Container Environment Variables
#
# Copy to .env:  cp .env.example .env
# =============================================================================

# Include :PORT when bootstrap NGINX_HTTP_PORT is not 80 (e.g. :8081)
NEXT_PUBLIC_APP_URL=http://cryptomation.local:8081

# Add backend vars here when backend is ready, e.g.:
# DATABASE_URL=postgresql://user:pass@cryptomation_postgres:5432/cryptomation
# REDIS_URL=redis://:pass@cryptomation_redis:6379
